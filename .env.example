# Optional OWNER setting for expanded YouTube search only.
# The automatic YouTube collection and TikTok playback work without this key.
# Enable YouTube Data API v3 in the Google Cloud project first.
YOUTUBE_API_KEY=
# Optional: a shared access code for the server APIs of a private deployment.
# Visitors enter it in Connections. It is kept only in memory in their tab.
APP_ACCESS_TOKEN=
# Optional local development port; Vercel ignores this.
PORT=4173
